# Copiar a .env y completar. Nunca commitear .env.

# Webhook de Google Apps Script que recibe los leads (T08): URL de la Web App, termina en /exec.
# Pasos en docs/apps-script/README.md. Vacía = el formulario ofrece WhatsApp como respaldo.
LEAD_WEBHOOK_URL=
# Secreto compartido con el Apps Script (propiedad LEAD_WEBHOOK_SECRET). Va en el cuerpo del POST.
# Generar con: openssl rand -hex 32
LEAD_WEBHOOK_SECRET=
# ID de Google Analytics 4, ej. G-XXXXXXX (T09)
PUBLIC_GA4_ID=
# ID de Meta Pixel (T09)
PUBLIC_META_PIXEL_ID=
# URL pública del sitio, ej. https://lavoro.com.ar (canonical, OG, sitemap)
PUBLIC_SITE_URL=

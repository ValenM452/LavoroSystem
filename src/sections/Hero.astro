---
/**
 * Hero partido: texto + caminos de compra a la izquierda, foto a la derecha (04 §2 + rediseño).
 * Home: dos tarjetas (B2C → tienda, B2B → cotización). /empresas: CTA cotizar + WhatsApp.
 */
import { site } from '../config/site';
import { copy } from '../config/copy';
import { images } from '../config/images';
import { tiendaTarget } from '../lib/links';
import { emphasis } from '../lib/emphasis';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import PathCard from '../components/PathCard.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';

interface Props { variant?: 'home' | 'empresas' }
const { variant = 'home' } = Astro.props;
const tienda = tiendaTarget('hero');
const h = variant === 'home' ? copy.hero : copy.empresas.hero;
const lead = variant === 'home' ? copy.hero.lead : copy.empresasHome.text;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <Eyebrow text={h.eyebrow} />
      <h1 id="hero-title" set:html={emphasis(h.title)} />
      <p class="lead hero__lead">{lead}</p>
      {variant === 'home' ? (
        <div class="hero__paths">
          <PathCard tone="light" href={tienda.href} pending={tienda.pending} track="click_tienda"
            label={copy.hero.b2c.label} title={copy.hero.b2c.title} text={copy.hero.b2c.text} cta={copy.hero.ctaTienda} />
          <PathCard tone="bordo" href={site.paths.cotizar}
            label={copy.hero.b2b.label} title={copy.hero.b2b.title} text={copy.hero.b2b.text} cta={copy.hero.ctaEmpresas} />
        </div>
      ) : (
        <div class="hero__ctas">
          <Button href="#cotizar" arrow>{copy.empresas.hero.cta}</Button>
          <Button href={site.contact.whatsappEmpresas.url} variant="whatsapp" track="click_whatsapp">{copy.empresas.hero.wa}</Button>
        </div>
      )}
    </div>
    <div class="hero__media">
      <ResponsiveImage img={images.hero[variant]} sizes="(min-width: 1024px) 45vw, 100vw" widths={[640, 960, 1280, 1600, 2000]} priority />
    </div>
  </div>
</section>

<style>
  /* Mobile: foto 4:3 arriba, a sangre del contenedor (docs/10 §4.1). Desktop: partido texto/foto. */
  .hero { padding-block: 0 var(--section-y); }
  .hero__grid { display: grid; gap: var(--sp-6); align-items: stretch; }
  .hero__copy { display: grid; gap: var(--sp-5); align-content: center; }
  .hero__copy h1 { max-width: 13em; }
  .hero__lead { margin: 0; color: var(--steel); max-width: 46ch; }
  .hero__paths { display: grid; gap: var(--sp-4); margin-top: var(--sp-2); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  .hero__media { order: -1; aspect-ratio: var(--ratio-photo); margin-inline: calc(-1 * var(--gutter)); overflow: hidden; }
  @media (min-width: 640px) {
    .hero { padding-top: var(--sp-6); }
    .hero__media { margin-inline: 0; border-radius: var(--radius-lg); aspect-ratio: var(--ratio-wide); }
    .hero__paths { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .hero { padding-top: var(--sp-8); }
    .hero__grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: var(--sp-8); }
    .hero__media { order: 0; aspect-ratio: auto; height: auto; min-height: var(--hero-media-min); }
  }
</style>

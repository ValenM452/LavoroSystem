---
/** 04 §7 — proceso B2B en 4 pasos sobre bordó profundo. Se reutiliza en /empresas. */
import { copy } from '../config/copy';
import SectionHeading from '../components/SectionHeading.astro';
import ProcessList from '../components/ProcessList.astro';
import Button from '../components/Button.astro';

interface Props { ctaHref: string }
const { ctaHref } = Astro.props;
---
<section class="section section--deep" aria-labelledby="proc-title">
  <div class="container proc">
    <div class="proc__head">
      <SectionHeading id="proc-title" eyebrow={copy.proceso.eyebrow} title={copy.proceso.title} />
      <Button href={ctaHref} tone="bordo" arrow>{copy.proceso.cta}</Button>
    </div>
    <ProcessList steps={copy.proceso.steps} />
  </div>
</section>

<style>
  .proc { display: grid; gap: var(--sp-7); }
  .proc__head { display: grid; gap: var(--sp-5); align-items: end; justify-items: start; }
  .proc :global(.pending) { margin-top: var(--sp-2); }
  @media (min-width: 1024px) { .proc__head { grid-template-columns: 1fr auto; } }
</style>

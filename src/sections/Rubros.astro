---
/** 04 §8 — SplitPanel foto + bordó con los 10 rubros (links que precargan el formulario). */
import { site } from '../config/site';
import { copy } from '../config/copy';
import { images } from '../config/images';
import { rubroHref } from '../lib/links';
import SplitPanel from '../components/SplitPanel.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
---
<SplitPanel img={images.rubrosSplit} tone="bordo" labelledby="rub-title">
  <SectionHeading id="rub-title" eyebrow={copy.rubros.eyebrow} title={copy.rubros.title} lead={copy.rubros.text} />
  <ul role="list" class="rub__list">
    {site.rubros.map((r) => <li><a class="link-u" href={rubroHref(r.slug)}>{r.label}</a></li>)}
  </ul>
  <div><Button href={site.paths.cotizar} tone="bordo" arrow>{copy.rubros.cta}</Button></div>
</SplitPanel>

<style>
  .rub__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--gutter); margin: 0; padding: 0; list-style: none; }
  .rub__list li { border-top: var(--hairline) solid var(--line-inv); }
  .rub__list a { display: flex; align-items: center; min-height: var(--tap); padding-block: var(--sp-1); }
</style>

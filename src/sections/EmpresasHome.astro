---
/** Rediseño: bloque B2B en la home — foto + qué podemos cotizar + CTA. Textos de 04 (/empresas y §3). */
import { site } from '../config/site';
import { copy } from '../config/copy';
import { images } from '../config/images';
import { emphasis } from '../lib/emphasis';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';

const e = copy.empresasHome;
---
<section class="section section--sand" aria-labelledby="emp-title">
  <div class="container grid emp">
    <div class="emp__media" data-reveal>
      <ResponsiveImage img={images.empresas} sizes="(min-width: 1024px) 40vw, 100vw" />
    </div>
    <div class="emp__copy">
      <Eyebrow text={e.eyebrow} />
      <h2 id="emp-title" set:html={emphasis(e.title)} />
      <p class="muted">{e.text}</p>
      <h3 class="emp__list-title">{e.listTitle}</h3>
      <ul role="list" class="emp__list">
        {copy.empresas.cotizamos.items.map((it) => <li>{it.title}</li>)}
      </ul>
      <div class="emp__ctas">
        <Button href={site.paths.cotizar} arrow>{e.cta}</Button>
        <a class="emp__more link-u" href={site.paths.empresas}>{e.more}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .emp { row-gap: var(--sp-7); align-items: center; }
  .emp__media, .emp__copy { grid-column: 1 / -1; }
  .emp__media { display: none; aspect-ratio: var(--ratio-photo); border-radius: var(--radius-lg); overflow: hidden; }
  /* En mobile la foto se omite: es la misma de Talleres en la grilla de Rubros que sigue (docs/10 §4). */
  @media (min-width: 640px) { .emp__media { display: block; aspect-ratio: var(--ratio-wide); } }
  .emp__copy { display: grid; gap: var(--sp-4); }
  .emp__copy p { margin: 0; }
  .emp__list-title { margin-top: var(--sp-3); font-family: var(--font-sans); font-size: var(--fs-small); font-weight: 600; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--bordo-700); }
  .emp__list { display: grid; gap: var(--sp-2) var(--gutter); margin: 0; padding: 0; list-style: none; }
  .emp__list li { display: flex; align-items: baseline; gap: var(--sp-3); }
  .emp__list li::before { content: ''; flex: none; width: var(--sp-2); height: var(--sp-2); background: var(--gold-500); transform: translateY(calc(-1 * var(--hairline))); }
  .emp__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-5); margin-top: var(--sp-3); }
  .emp__more { display: inline-flex; align-items: center; min-height: var(--tap); font-weight: 600; color: var(--bordo-700); }
  @media (min-width: 640px) { .emp__list { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) {
    .emp__media { grid-column: 1 / span 5; aspect-ratio: var(--ratio-tile); }
    .emp__copy { grid-column: 7 / -1; }
  }
</style>

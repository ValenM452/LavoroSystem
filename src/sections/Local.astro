---
/**
 * 04 §10 — tarjeta del local sobre una foto de la zona (Cuesta de Miranda). La foto NO es el local.
 * El iframe de Google Maps se carga solo al hacer click (cuando exista la dirección).
 */
import { site } from '../config/site';
import { copy } from '../config/copy';
import { images } from '../config/images';
import { externalTarget, isPending, pendingLabel, whatsappLink } from '../lib/links';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import Pending from '../components/Pending.astro';

const c = site.contact;
const maps = externalTarget(c.mapsUrl);
const embedReady = !isPending(c.mapsEmbedUrl);
---
<section class="local" aria-labelledby="local-title">
  <div class="local__media" data-map data-reveal-zoom>
    <ResponsiveImage img={images.local} sizes="100vw" widths={[640, 960, 1440, 2000]} />
  </div>
  <div class="container local__wrap">
    <div class="local__card" data-reveal>
      <SectionHeading id="local-title" eyebrow={copy.local.eyebrow} title={copy.local.title} />
      <ul role="list" class="local__data">
        <li><span class="local__k">{copy.form.datosDireccion}</span>{isPending(c.address) ? <Pending text={pendingLabel(c.address)} /> : c.address}</li>
        <li><span class="local__k">{copy.local.horarios}</span>{isPending(c.hours) ? <Pending text={pendingLabel(c.hours)} /> : c.hours}</li>
        <li><span class="local__k">{copy.local.waLabel}</span><a class="link-u" href={c.whatsappLocal.url}>{c.whatsappLocal.label}</a></li>
      </ul>
      <div class="local__ctas">
        <Button href={c.whatsappLocal.url} variant="whatsapp" track="click_whatsapp">{copy.local.escribir}</Button>
        {maps.pending ? (
          <Button href={whatsappLink('local', copy.wa.ubicacion)} variant="secondary" track="click_whatsapp" external>{copy.local.pedirUbicacion}</Button>
        ) : (
          <Button href={maps.href} variant="secondary" external>{copy.local.comoLlegar}</Button>
        )}
        {embedReady && <button type="button" class="btn btn--secondary" data-map-load={c.mapsEmbedUrl}>{copy.local.cargarMapa}</button>}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-map-load]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = btn.dataset.mapLoad!;
      frame.title = document.getElementById('local-title')?.textContent ?? '';
      frame.loading = 'lazy';
      frame.className = 'local__iframe';
      document.querySelector('[data-map]')?.replaceChildren(frame);
      frame.focus();
    });
  });
</script>

<style>
  .local { position: relative; }
  .local__media { aspect-ratio: var(--ratio-wide); overflow: hidden; }
  .local__media :global(.local__iframe) { width: 100%; height: 100%; border: 0; }
  .local__wrap { position: relative; margin-top: calc(-1 * var(--sp-8)); padding-bottom: var(--section-y); }
  .local__card { display: grid; gap: var(--sp-4); padding: var(--sp-5); border-radius: var(--radius-lg); background: var(--white); box-shadow: var(--shadow); border-top: var(--accent-bar) solid var(--gold-500); }
  .local__data { display: grid; gap: var(--sp-3); margin: 0; padding: 0; list-style: none; }
  .local__data li { display: grid; gap: var(--sp-1); justify-items: start; }
  .local__k { font-size: var(--fs-eyebrow); font-weight: 600; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--gold-700); }
  .local__data a { display: inline-flex; align-items: center; min-height: var(--tap); }
  .local__ctas { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  @media (min-width: 1024px) {
    .local__media { aspect-ratio: auto; height: var(--local-h); }
    .local__wrap { position: absolute; inset: 0; display: flex; align-items: center; margin: 0 auto; padding-bottom: 0; pointer-events: none; }
    .local__card { width: var(--panel-w); max-width: 100%; pointer-events: auto; }
  }
</style>

---
/** 04 §9 — titular + tarjeta bordó con datos de contacto a la izquierda, formulario a la derecha. */
import { site } from '../config/site';
import { copy } from '../config/copy';
import { isPending, pendingLabel } from '../lib/links';
import SectionHeading from '../components/SectionHeading.astro';
import LeadForm from '../components/LeadForm.astro';
import Pending from '../components/Pending.astro';
import Button from '../components/Button.astro';

interface Props { id: 'contacto' | 'cotizar' }
const { id } = Astro.props;
const c = site.contact;
---
<section class="section section--rule" id={id} aria-labelledby={`${id}-title`}>
  <div class="container grid cot">
    <div class="cot__aside">
      <SectionHeading id={`${id}-title`} eyebrow={copy.proceso.eyebrow} title={copy.form.title} />
      <div class="cot__card on-dark">
        <dl class="cot__data">
          <div><dt>{copy.form.datosWa}</dt><dd><a class="link-u" href={c.whatsappEmpresas.url}>{c.whatsappEmpresas.label}</a></dd></div>
          <div><dt>{copy.form.datosEmail}</dt><dd><a class="link-u" href={`mailto:${c.email}`}>{c.email}</a></dd></div>
          <div><dt>{copy.form.datosDireccion}</dt><dd>{isPending(c.address) ? <Pending text={pendingLabel(c.address)} /> : c.address}</dd></div>
        </dl>
        <Button href={c.whatsappEmpresas.url} variant="whatsapp" tone="bordo" track="click_whatsapp">{copy.nav.whatsapp}</Button>
      </div>
    </div>
    <div class="cot__form">
      <LeadForm idPrefix={id} />
    </div>
  </div>
</section>

<style>
  .cot__aside, .cot__form { grid-column: 1 / -1; }
  .cot__aside { display: grid; gap: var(--sp-6); align-content: start; }
  .cot { row-gap: var(--sp-6); }
  .cot__card { display: grid; gap: var(--sp-4); justify-items: start; padding: var(--sp-5); border-radius: var(--radius-lg); background: var(--bordo-900); background-image: var(--metal-bordo-panel); border-top: var(--accent-bar) solid var(--gold-500); }
  .cot__data { display: grid; gap: var(--sp-2); margin: 0; }
  .cot__data dt { font-size: var(--fs-eyebrow); font-weight: 600; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--gold-300); }
  .cot__data dd { margin: 0; overflow-wrap: anywhere; }
  .cot__data a { display: inline-flex; align-items: center; min-height: var(--tap); }
  .cot__form { padding: var(--sp-4); border: var(--hairline) solid var(--line); border-radius: var(--radius-lg); background: var(--white); box-shadow: var(--shadow); }
  @media (min-width: 768px) { .cot__form { padding: var(--sp-7); } .cot__card { padding: var(--sp-6); } .cot__data { gap: var(--sp-4); } }
  @media (min-width: 1024px) {
    .cot__aside { grid-column: 1 / span 4; position: sticky; top: calc(var(--header-h) + var(--sp-5)); align-self: start; }
    .cot__form { grid-column: 6 / -1; }
  }
</style>

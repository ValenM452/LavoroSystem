---
/** 04 §5 — reemplaza "Clientes que confían": wordmarks en texto (sin logos hasta tenerlos autorizados). */
import { site } from '../config/site';
import { copy } from '../config/copy';
import SectionHeading from '../components/SectionHeading.astro';
import Pending from '../components/Pending.astro';
---
<section class="section section--bordo" id="marcas" aria-labelledby="marcas-title">
  <div class="container grid marcas">
    <SectionHeading id="marcas-title" class="marcas__head" eyebrow={copy.marcas.eyebrow} title={copy.marcas.title} />
    <div class="marcas__body" data-reveal>
      <ul role="list" class="marcas__list">
        {site.brands.map((b) => <li class="marcas__brand">{b}</li>)}
      </ul>
      <Pending text={copy.marcas.pending} />
    </div>
  </div>
</section>

<style>
  .marcas { row-gap: var(--sp-6); align-items: center; }
  .marcas :global(.marcas__head), .marcas__body { grid-column: 1 / -1; }
  .marcas__body { display: grid; gap: var(--sp-4); justify-items: start; }
  .marcas__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; margin: 0; padding: 0; list-style: none; border-top: var(--hairline) solid var(--line-inv); border-left: var(--hairline) solid var(--line-inv); }
  .marcas__brand {
    display: grid;
    place-items: center;
    min-height: calc(var(--sp-8) + var(--sp-6));
    padding: var(--sp-4);
    border-right: var(--hairline) solid var(--line-inv);
    border-bottom: var(--hairline) solid var(--line-inv);
    font-weight: 700;
    font-size: var(--fs-h3);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    text-align: center;
    line-height: var(--lh-head);
  }
  @media (min-width: 1024px) {
    .marcas :global(.marcas__head) { grid-column: 1 / span 4; }
    .marcas__body { grid-column: 6 / -1; }
  }
  @media (min-width: 1280px) {
    .marcas__list { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>

---
/** 04 §5 — reemplaza "Clientes que confían": wordmarks en texto (sin logos hasta tenerlos autorizados). */
import { site } from '../config/site';
import { copy } from '../config/copy';
import SectionHeading from '../components/SectionHeading.astro';
import Pending from '../components/Pending.astro';
---
<section class="section section--rule marcas-sec" id="marcas" aria-labelledby="marcas-title">
  <div class="container marcas">
    <SectionHeading id="marcas-title" class="marcas__head" eyebrow={copy.marcas.eyebrow} title={copy.marcas.title} />
    <div class="marcas__body" data-reveal>
      <ul role="list" class="marcas__list">
        {site.brands.map((b) => <li class="marcas__brand">{b}</li>)}
      </ul>
      <Pending text={copy.marcas.pending} />
    </div>
  </div>
</section>

<style>
  /* Franja liviana sobre blanco (docs/10 §4.4): wordmarks en texto separados por "·". */
  .marcas-sec { padding-block: var(--sp-7); }
  .marcas { display: grid; gap: var(--sp-5); align-items: center; }
  .marcas__body { display: grid; gap: var(--sp-3); justify-items: start; }
  .marcas__list { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-2) var(--sp-5); margin: 0; padding: 0; list-style: none; }
  .marcas__brand {
    font-weight: 600;
    font-size: clamp(.9375rem, .85rem + .4vw, 1.125rem);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--steel);
    white-space: nowrap;
  }
  /* El separador "·" solo donde las marcas entran en una línea (en mobile quedaría al comienzo de renglón). */
  @media (min-width: 1024px) {
    .marcas__list { column-gap: 0; }
    .marcas__brand + .marcas__brand::before { content: '·'; margin-inline: var(--sp-4); color: var(--gold-500); }
    .marcas { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--gutter); }
    .marcas__body { justify-items: end; }
    .marcas__list { justify-content: flex-end; }
  }
</style>

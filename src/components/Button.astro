---
import Pending from './Pending.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'whatsapp';
  /** `dark` = sobre ink o foto; `bordo` = sobre bordó (el primario se invierte a blanco). */
  tone?: 'light' | 'dark' | 'bordo';
  arrow?: boolean;
  /** Texto del [[PENDIENTE]] cuando el destino todavía no existe. */
  pending?: string | null;
  external?: boolean;
  class?: string;
  /** Evento de medición (T09): se lee como data-track. */
  track?: string;
}
const { href, variant = 'primary', tone = 'light', arrow = false, pending = null, external = false, class: className, track } = Astro.props;
const classes = ['btn', variant === 'primary' ? 'btn--primary' : 'btn--secondary', tone === 'dark' && 'btn--on-dark', tone === 'bordo' && 'btn--on-bordo', pending && 'is-pending', className];
---
{pending ? (
  <span class="wrap">
    <a class:list={classes} href="#" aria-disabled="true" data-pending={pending}><slot />{arrow && <span aria-hidden="true">→</span>}</a>
    <Pending text={pending} />
  </span>
) : (
  <a class:list={classes} href={href} data-track={track} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
    {variant === 'whatsapp' && (
      <svg class="btn__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12.04 2a9.9 9.9 0 0 0-8.46 15.04L2 22l5.1-1.54A9.93 9.93 0 1 0 12.04 2Zm0 1.8a8.13 8.13 0 1 1-4.2 15.1l-.3-.18-3.02.91.92-2.95-.2-.31A8.12 8.12 0 0 1 12.04 3.8Zm-3.2 3.7c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.07 3.3 5.1 4.5 2.52 1 3.03.8 3.57.75.55-.05 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.27-.47-2.42-1.5-.9-.8-1.5-1.78-1.67-2.08-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.65-1.62-.9-2.2-.23-.55-.47-.5-.67-.5Z"/></svg>
    )}
    <slot />{arrow && <span aria-hidden="true">→</span>}
  </a>
)}

<style>
  .wrap { display: inline-flex; flex-wrap: wrap; align-items: center; gap: var(--sp-2); }
</style>

---
/** Mega menú "Rubros" (solo desktop ≥ 1024 px). Lógica en src/lib/nav.ts. */
import { site } from '../config/site';
import { copy } from '../config/copy';
import { images } from '../config/images';
import { rubroHref } from '../lib/links';
import ResponsiveImage from './ResponsiveImage.astro';
import Button from './Button.astro';
---
<div class="mega" data-mega>
  <button type="button" class="mega__trigger" aria-expanded="false" aria-controls="mega-rubros" data-mega-trigger>
    {copy.nav.rubros}
    <svg class="mega__chevron" viewBox="0 0 12 8" width="12" height="8" aria-hidden="true" focusable="false"><path d="M1 1.5 6 6.5l5-5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
  </button>

  <div class="mega__panel" id="mega-rubros" data-mega-panel hidden>
    <div class="container grid mega__inner">
      <div class="mega__nav">
        <p class="eyebrow">{copy.mega.eyebrow}</p>
        <ul role="list" class="mega__list">
          {site.rubros.map((r) => (
            <li><a class="mega__item link-u" href={rubroHref(r.slug)} data-mega-item={r.slug}>{r.label}</a></li>
          ))}
        </ul>
        <a class="mega__all link-u" href={site.paths.rubrosEmpresas}>{copy.mega.verTodos} <span aria-hidden="true">→</span></a>
      </div>
      <div class="mega__previews">
        {site.rubros.map((r) => (
          <div class="mega__preview" data-mega-preview={r.slug} hidden>
            <ResponsiveImage img={images.rubros[r.slug]} ratio="photo" sizes="(min-width: 1024px) 50vw, 0px" widths={[480, 800, 1200]} />
            <p class="mega__phrase">{copy.mega.frases[r.slug]}</p>
            <Button href={rubroHref(r.slug)} variant="secondary" arrow>{copy.mega.cotizarPara(r.label)}</Button>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .mega__trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: var(--tap);
    padding: 0;
    border: 0;
    background-color: transparent;
    font-size: var(--fs-small);
    font-weight: 500;
    color: inherit;
  }
  .mega__trigger:hover, .mega__trigger[aria-expanded='true'] { color: var(--bordo-700); }
  .mega__chevron { transition: transform var(--dur-fast) var(--ease); }
  .mega__trigger[aria-expanded='true'] .mega__chevron { transform: rotate(180deg); }

  .mega__panel {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background: var(--white);
    color: var(--ink);
    border-top: var(--hairline) solid var(--line);
    box-shadow: var(--shadow);
    padding-block: var(--sp-6);
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
  }
  .mega__inner { align-items: start; row-gap: var(--sp-5); }
  /* Dos columnas de 5 (docs/10 §3.3). Flujo por columna: el orden del DOM coincide con las flechas del teclado. */
  .mega__nav { grid-column: 1 / span 6; display: grid; gap: var(--sp-4); justify-items: start; }
  .mega__list { display: grid; grid-auto-flow: column; grid-template-rows: repeat(5, auto); column-gap: var(--gutter); width: 100%; margin: 0; padding: 0; list-style: none; }
  .mega__list li { border-top: var(--hairline) solid var(--line); }
  .mega__all { display: inline-flex; align-items: center; gap: var(--sp-2); min-height: var(--tap); font-size: var(--fs-small); font-weight: 600; color: var(--bordo-700); }
  .mega__item {
    display: inline-block;
    padding-block: var(--sp-2);
    min-height: var(--tap);
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 300;
    letter-spacing: var(--tracking-head);
  }
  .mega__item.is-active { color: var(--bordo-700); font-style: italic; }
  .mega__previews { grid-column: 8 / -1; }
  .mega__preview { display: grid; gap: var(--sp-4); justify-items: start; }
  .mega__preview :global(.rimg) { width: 100%; max-height: 40vh; border-radius: var(--radius-lg); }
  .mega__phrase { margin: 0; }
</style>

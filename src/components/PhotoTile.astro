---
/**
 * Foto con nombre en serif. `tile` = nombre sobre la foto (Categorías, grilla de rubros);
 * `row` = miniatura + nombre (lista de rubros en mobile). Área clicable completa.
 */
import type { ImageSlot } from '../config/images';
import ResponsiveImage from './ResponsiveImage.astro';
import Pending from './Pending.astro';

interface Props {
  img: ImageSlot;
  label: string;
  href: string;
  /** Destino pendiente: el tile se muestra sin link y con el [[PENDIENTE]]. */
  pending?: string | null;
  variant?: 'tile' | 'row';
  ratio?: 'tile' | 'photo';
  sizes: string;
  /** Atributos extra para el link (precarga de rubro en /empresas). */
  rubro?: string;
}
const { img, label, href, pending = null, variant = 'tile', ratio = 'tile', sizes, rubro } = Astro.props;
const Tag = pending ? 'div' : 'a';
---
<Tag class:list={['ptile', `ptile--${variant}`]} href={pending ? undefined : href} data-rubro-link={rubro}>
  <ResponsiveImage img={img} ratio={variant === 'row' ? 'square' : ratio} sizes={variant === 'row' ? '64px' : sizes} widths={variant === 'row' ? [128] : [400, 600, 900, 1200]} hideTag />
  {variant === 'tile' && <span class="ptile__overlay" aria-hidden="true"></span>}
  <span class="ptile__caption">
    {img.pending && <Pending text={img.pending} />}
    {pending && <Pending text={pending} />}
    <span class="ptile__label">{label}</span>
  </span>
</Tag>

<style>
  .ptile { position: relative; display: block; color: var(--white); text-decoration: none; }
  .ptile--tile { overflow: hidden; }
  .ptile__overlay { position: absolute; inset: 0; background: var(--overlay-photo); }
  .ptile--tile .ptile__caption {
    position: absolute;
    left: var(--sp-4);
    right: var(--sp-4);
    bottom: var(--sp-4);
    display: grid;
    justify-items: start;
    gap: var(--sp-2);
  }
  .ptile :global(.pending) { font-size: var(--fs-tag); padding: var(--hairline) var(--sp-1); }
  .ptile--tile .ptile__label {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--fs-h3);
    line-height: var(--lh-head);
    letter-spacing: var(--tracking-head);
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 var(--hairline) no-repeat;
    transition: background-size var(--dur-fast) var(--ease);
  }
  a.ptile--tile:hover .ptile__label, a.ptile--tile:focus-visible .ptile__label { background-size: 100% var(--hairline); }

  .ptile--row {
    display: grid;
    grid-template-columns: var(--thumb) 1fr;
    align-items: center;
    gap: var(--sp-4);
    min-height: var(--thumb);
    color: inherit;
  }
  .ptile--row .ptile__label { font-family: var(--font-display); font-size: var(--fs-h3); font-weight: 300; }
  .ptile--row .ptile__caption { display: grid; justify-items: start; gap: var(--sp-1); }
</style>

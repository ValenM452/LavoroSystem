---
/**
 * Barra flotante inferior (solo < 1024 px): los cuatro destinos principales al alcance del pulgar.
 * "Menú" abre el <dialog> de MobileMenu (lógica en src/lib/nav.ts, por data-mobile-open).
 */
import { site } from '../config/site';
import { copy } from '../config/copy';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const d = copy.dock;
const items = [
  { href: site.paths.tienda, label: d.tienda, icon: 'M4 7h16l-1.2 12.1a1 1 0 0 1-1 .9H6.2a1 1 0 0 1-1-.9L4 7Zm4 0a4 4 0 0 1 8 0' },
  { href: site.paths.rubros, label: d.rubros, icon: 'M4 5h7v6H4zM13 5h7v6h-7zM4 13h7v6H4zM13 13h7v6h-7z' },
  { href: site.paths.cotizar, label: d.cotizar, icon: 'M6 3h9l4 4v14H6zM14 3v5h5M9 13h7M9 17h5' },
];
---
<nav class="dock" aria-label={d.etiqueta}>
  <ul role="list" class="dock__list">
    {items.map((it) => (
      <li>
        <a class="dock__item" href={it.href} aria-current={path === it.href ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d={it.icon} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
          <span>{it.label}</span>
        </a>
      </li>
    ))}
    <li>
      <button type="button" class="dock__item" aria-expanded="false" aria-haspopup="dialog" data-mobile-open>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
        <span>{d.menu}</span>
      </button>
    </li>
  </ul>
</nav>

<style>
  .dock {
    position: fixed;
    inset: auto var(--sp-3) calc(var(--sp-3) + env(safe-area-inset-bottom, 0px));
    z-index: var(--z-header);
  }
  .dock__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    max-width: 30rem;
    height: var(--dock-h);
    margin: 0 auto;
    padding: var(--sp-1);
    border-radius: var(--radius-pill);
    background: rgba(23, 24, 27, .92);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: 0 0 0 var(--hairline) var(--line-inv), 0 12px 30px rgba(0, 0, 0, .4);
  }
  .dock__item {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 2px;
    width: 100%;
    height: 100%;
    min-height: var(--tap);
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--graf-300);
    font-size: .75rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    --focus-outer: var(--white);
  }
  .dock__item[aria-current='page'] { background: var(--bordo-700); background-image: var(--metal-bordo-btn); box-shadow: var(--metal-shine); color: var(--white); }
  .dock__item:hover { color: var(--white); }
  @media (min-width: 1024px) { .dock { display: none; } }
</style>

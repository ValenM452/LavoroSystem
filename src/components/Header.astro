---
import { site } from '../config/site';
import { copy } from '../config/copy';
import { tiendaTarget } from '../lib/links';
import Logo from './Logo.astro';
import Button from './Button.astro';
import MegaMenu from './MegaMenu.astro';
import MobileMenu from './MobileMenu.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const tienda = tiendaTarget('nav');
const c = site.contact;
---
<div class="topbar on-dark" data-seccion="topbar">
  <div class="container topbar__inner">
    <p class="topbar__text">{copy.topbar.left}</p>
    <ul role="list" class="topbar__links">
      <li><a class="link-u" href={c.whatsappEmpresas.url}>{copy.topbar.empresas} {c.whatsappEmpresas.label}</a></li>
      <li><a class="link-u" href={c.whatsappLocal.url}>{copy.topbar.local} {c.whatsappLocal.label}</a></li>
    </ul>
  </div>
</div>
<div class="sentinel" data-header-sentinel aria-hidden="true"></div>
<header class="header" data-header>
  <div class="container header__bar">
    <a class="header__logo" href={site.paths.home} aria-label={copy.a11y.logoLabel}><Logo /></a>

    <nav class="header__nav" aria-label={copy.a11y.principal}>
      <ul role="list">
        <li>
          <a class:list={['header__link', tienda.pending && 'is-pending']} href={tienda.href} aria-disabled={tienda.pending ? 'true' : undefined} data-pending={tienda.pending ?? undefined} title={tienda.pending ? `[[PENDIENTE: ${tienda.pending}]]` : undefined}>{copy.nav.tienda} <span aria-hidden="true">↗</span></a>
        </li>
        <li><a class="header__link" href={site.paths.empresas} aria-current={path === site.paths.empresas ? 'page' : undefined}>{copy.nav.empresas}</a></li>
        <li><MegaMenu /></li>
        <li><a class="header__link" href={site.paths.catalogo}>{copy.nav.catalogo}</a></li>
        <li><a class="header__link" href={site.paths.personalizacion}>{copy.nav.personalizacion}</a></li>
        <li><a class="header__link" href={site.paths.marcas}>{copy.nav.marcas}</a></li>
        <li><a class="header__link" href={site.paths.contacto}>{copy.nav.contacto}</a></li>
      </ul>
    </nav>

    <div class="header__actions">
      <Button class="header__cta" href={site.paths.cotizar}>{copy.nav.cotizar}</Button>
      <button type="button" class="header__burger" aria-expanded="false" aria-haspopup="dialog" data-mobile-open aria-label={copy.nav.abrirMenu}>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="1.5" fill="none" /></svg>
      </button>
    </div>
  </div>
</header>
<MobileMenu />

<script>
  import '../lib/header';
  import '../lib/nav';
</script>

<style>
  .topbar { display: none; background: var(--bordo-900); color: var(--white); font-size: var(--fs-small); }
  .topbar__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-5); min-height: var(--topbar-h); }
  .topbar__text { margin: 0; color: var(--bordo-100); }
  .topbar__links { display: flex; gap: var(--sp-5); margin: 0; }
  .topbar__links a { display: inline-flex; align-items: center; min-height: var(--topbar-h); text-decoration: none; }
  @media (min-width: 768px) { .topbar { display: block; } }

  .sentinel { position: absolute; top: 0; left: 0; width: var(--hairline); height: var(--sp-7); pointer-events: none; }

  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    height: var(--header-h);
    background: var(--white);
    color: var(--ink);
    border-bottom: var(--hairline) solid var(--line);
    transition: box-shadow var(--dur-menu) var(--ease);
  }
  .header.is-solid { box-shadow: var(--shadow); border-bottom-color: transparent; }

  .header__bar { display: flex; align-items: center; gap: var(--sp-5); height: 100%; }
  .header__logo { text-decoration: none; display: inline-flex; align-items: center; min-height: var(--tap); color: var(--bordo-700); }
  .header__actions { display: flex; align-items: center; gap: var(--sp-2); margin-left: auto; }
  .header__burger {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--bordo-700);
  }

  .header__nav { display: none; }
  .header__nav ul { display: flex; align-items: center; gap: var(--sp-5); margin: 0; padding: 0; list-style: none; }
  .header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    min-height: var(--tap);
    font-size: var(--fs-small);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }
  .header__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--sp-2);
    height: var(--ring);
    background: var(--gold-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease);
  }
  .header__link:hover, .header__link[aria-current='page'] { color: var(--bordo-700); }
  .header__link:hover::after, .header__link[aria-current='page']::after { transform: scaleX(1); }
  .header__link.is-pending { text-decoration: underline dashed; text-underline-offset: var(--sp-1); }

  @media (min-width: 1024px) {
    .header__nav { display: block; margin-inline: auto; }
    .header__actions { margin-left: 0; }
    .header__burger { display: none; }
  }
  @media (min-width: 1024px) and (max-width: 1199px) {
    .header__nav ul { gap: var(--sp-4); }
  }
</style>

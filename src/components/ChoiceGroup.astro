---
/** Grupo de radios o checkboxes con fieldset/legend y error en texto. */
interface Props {
  id: string;
  name: string;
  legend: string;
  type: 'radio' | 'checkbox';
  options: readonly string[];
  required?: boolean;
  columns?: 1 | 2;
  /** Clave del error (para checkboxes, `productos[]` se valida como `productos`). */
  errorKey?: string;
}
const { id, name, legend, type, options, required = false, columns = 1, errorKey = name } = Astro.props;
const errorId = `${id}-error`;
---
<fieldset class="choices" aria-describedby={errorId}>
  <legend class="field__label">{legend}</legend>
  <div class:list={['choices__list', columns === 2 && 'choices__list--2']}>
    {options.map((o, i) => (
      <label class="choice">
        <input type={type} name={name} value={o} required={type === 'radio' && required && i === 0} aria-describedby={errorId} />
        <span>{o}</span>
      </label>
    ))}
  </div>
  <p class="field__error" id={errorId} data-error-for={errorKey}></p>
</fieldset>

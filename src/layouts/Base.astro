---
/**
 * Layout base: fuentes, tokens, SEO (title, description, canonical, OG), header y footer.
 * Medición (05 §5, T09): GA4 y Meta Pixel solo si existe su ID en env. Los stubs (`gtag`, `fbq`)
 * se definen al instante para encolar eventos; los scripts reales se piden después de `load`,
 * con la primera interacción o a los 3,5 s, para no competir con el LCP.
 */
import '@fontsource-variable/tektur/wght.css';
import '@fontsource-variable/hanken-grotesk/wght.css';
import tekturLatin from '@fontsource-variable/tektur/files/tektur-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/base.css';
import { site } from '../config/site';
import { copy } from '../config/copy';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileDock from '../components/MobileDock.astro';
import { PUBLIC_GA4_ID, PUBLIC_META_PIXEL_ID } from 'astro:env/client';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** La página abre con una foto a sangre detrás del header flotante. */
  bleed?: boolean;
}

const { title = site.name, description = '', noindex = false, bleed = false } = Astro.props;
const ga4Id = PUBLIC_GA4_ID?.trim() ?? '';
const pixelId = PUBLIC_META_PIXEL_ID?.trim() ?? '';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="preload" href={tekturLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {(ga4Id || pixelId) && (
      <script is:inline define:vars={{ ga4Id, pixelId }}>
        const w = window;
        const srcs = [];
        if (ga4Id) {
          w.dataLayer = w.dataLayer || [];
          w.gtag = function () { w.dataLayer.push(arguments); };
          w.gtag('js', new Date());
          w.gtag('config', ga4Id);
          srcs.push('https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(ga4Id));
        }
        if (pixelId && !w.fbq) {
          const n = (w.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); });
          w._fbq = n; n.push = n; n.loaded = true; n.version = '2.0'; n.queue = [];
          w.fbq('init', pixelId);
          w.fbq('track', 'PageView');
          srcs.push('https://connect.facebook.net/en_US/fbevents.js');
        }
        let done = false;
        const evs = ['pointerdown', 'keydown', 'scroll', 'touchstart'];
        const inject = () => {
          if (done) return;
          done = true;
          evs.forEach((e) => w.removeEventListener(e, inject));
          srcs.forEach((src) => { const s = document.createElement('script'); s.async = true; s.src = src; document.head.appendChild(s); });
        };
        const arm = () => {
          evs.forEach((e) => w.addEventListener(e, inject, { once: true, passive: true }));
          setTimeout(inject, 3500);
        };
        document.readyState === 'complete' ? arm() : w.addEventListener('load', arm, { once: true });
      </script>
    )}
  </head>
  <body class:list={[bleed && 'is-bleed']}>
    <a class="skip-link" href="#contenido">{copy.a11y.skip}</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <MobileDock />
    <script>
      import '../lib/reveal';
      import { initClickTracking } from '../lib/track';
      initClickTracking();
    </script>
  </body>
</html>

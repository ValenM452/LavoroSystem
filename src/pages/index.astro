---
/** Home (rediseño 20/10): portada (LAVORO detrás del Fitz Roy), rubros, tienda, empresas y local. */
import Base from '../layouts/Base.astro';
import { copy } from '../config/copy';
import Portada from '../sections/Portada.astro';
import RubrosIndex from '../sections/RubrosIndex.astro';
import TiendaHome from '../sections/TiendaHome.astro';
import EmpresasBanda from '../sections/EmpresasBanda.astro';
import LocalBanda from '../sections/LocalBanda.astro';
---

<Base title={copy.seo.home.title} description={copy.seo.home.description} bleed>
  <Portada />
  <RubrosIndex />
  <TiendaHome />
  <EmpresasBanda />
  <LocalBanda />
</Base>

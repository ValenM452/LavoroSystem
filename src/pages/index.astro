---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { copy } from '../config/copy';
import Hero from '../sections/Hero.astro';
import Declaracion from '../sections/Declaracion.astro';
import Categorias from '../sections/Categorias.astro';
import Marcas from '../sections/Marcas.astro';
import Personalizacion from '../sections/Personalizacion.astro';
import Proceso from '../sections/Proceso.astro';
import Rubros from '../sections/Rubros.astro';
import Cotizar from '../sections/Cotizar.astro';
import Local from '../sections/Local.astro';
import Cierre from '../sections/Cierre.astro';
---

<Base title={copy.seo.home.title} description={copy.seo.home.description} overlay>
  <Hero />
  <Declaracion />
  <Categorias />
  <Marcas />
  <Personalizacion />
  <Proceso ctaHref={site.paths.cotizar} />
  <Rubros />
  <Cotizar id="contacto" />
  <Local />
  <Cierre />
</Base>

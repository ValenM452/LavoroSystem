---
import Base from '../layouts/Base.astro';
import { copy } from '../config/copy';
import Hero from '../sections/Hero.astro';
import Confianza from '../sections/Confianza.astro';
import Catalogo from '../sections/Catalogo.astro';
import Marcas from '../sections/Marcas.astro';
import EmpresasHome from '../sections/EmpresasHome.astro';
import Proceso from '../sections/Proceso.astro';
import RubrosGrid from '../sections/RubrosGrid.astro';
import Personalizacion from '../sections/Personalizacion.astro';
import Cotizar from '../sections/Cotizar.astro';
import Local from '../sections/Local.astro';
import Cierre from '../sections/Cierre.astro';
---

<Base title={copy.seo.home.title} description={copy.seo.home.description}>
  <Hero />
  <Confianza />
  <Catalogo />
  <Marcas />
  <EmpresasHome />
  <RubrosGrid />
  <Personalizacion />
  <Proceso />
  <Cotizar id="contacto" />
  <Local />
  <Cierre />
</Base>

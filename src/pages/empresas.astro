---
/** /empresas (04 "/empresas"): solo reutiliza componentes y secciones de la home. */
import Base from '../layouts/Base.astro';
import { copy } from '../config/copy';
import Hero from '../sections/Hero.astro';
import ListaEditorial from '../sections/ListaEditorial.astro';
import RubrosGrid from '../sections/RubrosGrid.astro';
import Proceso from '../sections/Proceso.astro';
import Cotizar from '../sections/Cotizar.astro';
import Cierre from '../sections/Cierre.astro';

const e = copy.empresas;
---

<Base title={e.seo.title} description={e.seo.description} overlay>
  <Hero variant="empresas" />
  <ListaEditorial id="cotizamos" title={e.cotizamos.title} items={e.cotizamos.items} />
  <RubrosGrid />
  <Proceso ctaHref="#cotizar" />
  <ListaEditorial id="porque" title={e.porque.title} items={e.porque.items} />
  <Cotizar id="cotizar" />
  <Cierre />
</Base>
